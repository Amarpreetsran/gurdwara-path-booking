rules_version = '2';
// Security rules for Gurdwara Path Booking.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
//
// What these rules guarantee:
//  - Anyone can see which dates are booked (family name and occasion only).
//  - Anyone can book a free place, but nobody can overwrite or change an existing booking,
//    so the same place can never be booked twice, and nobody can book more places than
//    the committee allows for that path (settings/main -> capacity).
//  - Phone numbers and notes (the "contacts" collection) can be read only by committee members.
//  - Committee roles: the first members (in the "admins" or "Gurlal" collection) and users with role
//    "admin" are Pardhan / Admin; "treasurer" (Khazanchi) handles money out, refunds and voids;
//    "sevadar" does office work: bookings, payments received and receipts, but cannot void,
//    refund, cancel, delete or change settings.
//  - Every committee action is written to an activity log that nobody can edit or delete.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Committee roles ----------
    function isOwner() {
      return request.auth != null
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            || exists(/databases/$(database)/documents/Gurlal/$(request.auth.uid)));
    }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function roleIn(list) {
      return request.auth != null && exists(staffPath())
        && get(staffPath()).data.active == true && get(staffPath()).data.role in list;
    }
    function isAdmin() { return isOwner() || roleIn(['admin']); }
    function isTreasurer() { return isOwner() || roleIn(['admin', 'treasurer']); }
    function isStaff() { return isOwner() || roleIn(['admin', 'treasurer', 'sevadar']); }
    // A sevadar may only add receipts and money received: nothing earlier is changed or removed.
    function onlyAdds(key) {
      let n = request.resource.data.get(key, []);
      let o = resource.data.get(key, []);
      return n.size() >= o.size() && n[0:o.size()] == o;
    }
    function sevadarLookupUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipts', 'sevaReceipts', 'paidOnline', 'paidCash', 'checking'])
        && request.resource.data.get('paidOnline', 0) >= resource.data.get('paidOnline', 0)
        && request.resource.data.get('paidCash', 0) >= resource.data.get('paidCash', 0)
        && onlyAdds('receipts') && onlyAdds('sevaReceipts');
    }
    function isDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function text(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function dateClosed(d) {
      return exists(/databases/$(database)/documents/settings/main)
        && d in get(/databases/$(database)/documents/settings/main).data.get('closed', []);
    }
    function inFuture(s) {
      let p = s.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) > request.time;
    }
    // Minimum days ahead for each path (committee setting "leadDays"; defaults: Akhand Path 7, Sehaj Path 3).
    function leadDays(type) {
      let dflt = type == 'akhand' ? 7 : 3;
      return exists(/databases/$(database)/documents/settings/main)
        ? get(/databases/$(database)/documents/settings/main).data.get('leadDays', {}).get(type, dflt)
        : dflt;
    }
    // Seva bheta given online without a path booking (reference "S" + 5). The phone is kept apart, for the committee only.
    function sevaPath(ref) { return /databases/$(database)/documents/sevaonly/$(ref); }
    function sevaContactPath(ref) { return /databases/$(database)/documents/sevacontacts/$(ref); }
    function farEnough(s, type) {
      let p = s.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) > request.time + duration.value((leadDays(type) - 1) * 24, 'h');
    }
    function contactPath(id) { return /databases/$(database)/documents/contacts/$(id); }
    function slotPath(id) { return /databases/$(database)/documents/slots/$(id); }
    function movePath(id) { return /databases/$(database)/documents/reschedules/$(id); }
    // True when this request also records a valid move of the booking that starts at startId.
    function beingMoved(startId) {
      return exists(contactPath(startId))
        && existsAfter(movePath(startId + '_' + get(contactPath(startId)).data.ref));
    }
    // A booking keeps its original booking time when its date is changed, so the
    // 24-hour change window always counts from when it was first booked.
    function keptBookingTime(d) {
      let startId = d.start + '__' + d.type + '__' + string(d.seat);
      let ref = getAfter(contactPath(startId)).data.ref;
      let l = getAfter(/databases/$(database)/documents/lookup/$(ref)).data;
      return l.slot == startId && l.get('prev', '') != ''
        && existsAfter(movePath(l.prev + '_' + ref))
        && get(slotPath(l.prev)).data.get('bookedAt', null) == d.bookedAt;
    }
    function settingsPath() { return /databases/$(database)/documents/settings/main; }
    function feeFor(type) {
      return exists(settingsPath()) ? get(settingsPath()).data.get('fees', {}).get(type, 0) : 0;
    }
    // % of the bheta taken off when the whole amount is paid online (committee setting, default 10).
    function discountPct() {
      return exists(settingsPath()) ? get(settingsPath()).data.get('onlineDiscountPct', 10) : 10;
    }
    function lookupPath(ref) { return /databases/$(database)/documents/lookup/$(ref); }
    function validReport(rid) {
      let r = request.resource.data;
      let l = get(lookupPath(r.ref)).data;
      let n = l.get('reports', 0) + 1;
      return r.keys().hasOnly(['ref', 'utr', 'amount', 'seva', 'createdAt'])
        && l.get('closed', '') == ''
        && rid == r.ref + '_' + string(n)
        && getAfter(lookupPath(r.ref)).data.reports == n
        && r.utr is string && r.utr.matches('^[0-9A-Za-z]{6,30}$')
        && r.amount is number && r.amount >= 0 && r.amount <= l.total
        // optional seva bheta for Gurdwara Sahib, apart from the path bheta
        && r.get('seva', 0) is int && r.get('seva', 0) >= 0 && r.get('seva', 0) <= 100000
        && r.amount + r.get('seva', 0) >= 1
        && (l.get('paidOnline', 0) + l.get('paidCash', 0) > 0 || l.get('checking', false) == true || r.amount * 100 >= l.total * 20)
        && r.createdAt == request.time;
    }
    // How many places the committee allows for this path (set on the committee page, max 10).
    function placesFor(type) {
      return exists(/databases/$(database)/documents/settings/main)
        ? get(/databases/$(database)/documents/settings/main).data.get('capacity', {}).get(type, 1)
        : 1;
    }

    function validSlot(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'date', 'start', 'part', 'seat', 'name', 'occasion', 'next', 'bookedAt', 'createdAt'])
        && d.type in ['akhand', 'sehaj']
        && isDate(d.date) && isDate(d.start)
        && d.seat is int && d.seat >= 1 && d.seat <= 10 && d.seat <= placesFor(d.type)
        && id == d.date + '__' + d.type + '__' + string(d.seat)
        && text(d.name, 150) && text(d.occasion, 150)
        && d.createdAt == request.time
        && d.bookedAt is timestamp
        && (d.bookedAt == request.time || keptBookingTime(d))
        && !dateClosed(d.date)
        && inFuture(d.start)
        && (isStaff() || farEnough(d.start, d.type))
        && (
          // First day of any path: must come with the private contact record.
          (d.part == 0 && d.date == d.start && existsAfter(contactPath(id))
            && (d.type != 'akhand'
                || (d.next is string && existsAfter(slotPath(d.next))
                    && getAfter(slotPath(d.next)).data.start == d.start
                    && getAfter(slotPath(d.next)).data.part == 1
                    && getAfter(slotPath(d.next)).data.seat == d.seat)))
          // Second day of an Akhand Path: must come with its first day.
          || (d.part == 1 && d.type == 'akhand' && d.date > d.start
              && existsAfter(slotPath(d.start + '__akhand__' + string(d.seat)))
              && getAfter(slotPath(d.start + '__akhand__' + string(d.seat))).data.next == id)
        );
    }

    match /slots/{id} {
      allow read: if true;
      allow create: if validSlot(id);
      allow update: if false;
      allow delete: if isAdmin()
        || beingMoved(resource.data.start + '__' + resource.data.type + '__' + string(resource.data.seat));
    }

    match /contacts/{id} {
      allow read: if isStaff();
      allow delete: if isAdmin() || existsAfter(movePath(id + '_' + resource.data.ref));
      // The committee moves a cancelled booking's contact to "cx_<ref>" so its date can be booked again.
      allow create: if (isAdmin() && id.matches('^cx_[A-Z0-9]{6}$'))
        || (!exists(slotPath(id))
        && existsAfter(slotPath(id))
        && request.resource.data.keys().hasOnly(['phone', 'note', 'name', 'ref', 'pkey', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+ -]{7,20}$')
        && request.resource.data.note is string && request.resource.data.note.size() <= 1200
        && text(request.resource.data.name, 150)
        && text(request.resource.data.ref, 10)
        && request.resource.data.createdAt == request.time);
      allow update: if false;
    }

    // Booking reference -> the booking's bheta account (amounts, receipts, status).
    // Anyone who knows a reference can read it; nobody but the committee can list them.
    match /lookup/{ref} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['slot', 'type', 'name', 'start', 'total', 'discount',
            'paidOnline', 'paidCash', 'receipts', 'reports', 'checking', 'closed'])
        && request.resource.data.slot is string
        && !exists(slotPath(request.resource.data.slot))
        && existsAfter(slotPath(request.resource.data.slot))
        && getAfter(contactPath(request.resource.data.slot)).data.ref == ref
        && request.resource.data.type == getAfter(slotPath(request.resource.data.slot)).data.type
        && request.resource.data.name == getAfter(slotPath(request.resource.data.slot)).data.name
        && request.resource.data.start == getAfter(slotPath(request.resource.data.slot)).data.start
        && request.resource.data.total == feeFor(request.resource.data.type)
        && request.resource.data.discount is int
        && request.resource.data.discount * 100 >= request.resource.data.total * discountPct() - 50
        && request.resource.data.discount * 100 < request.resource.data.total * discountPct() + 50
        && request.resource.data.paidOnline == 0 && request.resource.data.paidCash == 0
        && request.resource.data.receipts == [] && request.resource.data.reports == 0
        && request.resource.data.checking == false && request.resource.data.closed == '';
      allow update: if isAdmin()
        // Khazanchi: money matters (refunds, voids), but not cancelling or changing the booking itself
        || (isTreasurer() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['closed', 'cancelReason', 'slot', 'prev', 'start', 'type', 'name', 'total', 'discount']))
        // Sevadar: payments received and their receipts only
        || (isStaff() && sevadarLookupUpdate())
        // date change by the person who booked
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slot', 'prev', 'start'])
          && request.resource.data.prev == resource.data.slot
          && existsAfter(movePath(resource.data.slot + '_' + ref))
          && existsAfter(slotPath(request.resource.data.slot))
          && getAfter(contactPath(request.resource.data.slot)).data.ref == ref
          && request.resource.data.start == getAfter(slotPath(request.resource.data.slot)).data.start)
        // "I have paid" report, together with the report itself
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'checking'])
          && request.resource.data.reports == resource.data.get('reports', 0) + 1
          && request.resource.data.checking == true
          && existsAfter(/databases/$(database)/documents/reports/$(ref + '_' + string(request.resource.data.reports))));
      allow delete: if isAdmin();
    }

    // A record of each date change made by the person who booked.
    // Allowed only with the right phone number, within 48 hours of booking, and only
    // when the old dates are removed and the new booking is added in the same step.
    match /reschedules/{rid} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['old', 'ref', 'pkey', 'next', 'createdAt'])
        && rid == request.resource.data.old + '_' + request.resource.data.ref
        && exists(contactPath(request.resource.data.old))
        && get(contactPath(request.resource.data.old)).data.ref == request.resource.data.ref
        && get(contactPath(request.resource.data.old)).data.get('pkey', '') == request.resource.data.pkey
        && request.resource.data.pkey.size() >= 7
        && get(slotPath(request.resource.data.old)).data.bookedAt + duration.value(48, 'h') > request.time
        && inFuture(get(slotPath(request.resource.data.old)).data.start)
        && !existsAfter(slotPath(request.resource.data.old))
        && existsAfter(slotPath(request.resource.data.next))
        && getAfter(contactPath(request.resource.data.next)).data.ref == request.resource.data.ref
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // "I have paid" reports from devotees (UPI transaction ID). Only the committee can read them.
    // The first payment must be at least 20% of the bheta (the advance needed to keep the booking).
    match /reports/{rid} {
      allow read, update: if isStaff();
      allow delete: if isAdmin();
      allow create: if validReport(rid);
    }

    // Receipt numbering. Committee only.
    // Record of automatic WhatsApp messages. Written only by the server.
    match /notices/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Receipt numbering. A sevadar can only move a number on by one (issuing a receipt);
    // setting where numbering continues is for the Khazanchi / Pardhan.
    match /counters/{id} {
      allow read: if isStaff();
      allow write: if isTreasurer()
        || (isStaff() && id in ['receipts', 'seva']
            && request.resource.data.keys().hasOnly(['fy', 'next'])
            && ((resource == null && request.resource.data.next == 2)
                || (resource != null && resource.data.fy != request.resource.data.fy && request.resource.data.next == 2)
                || (resource != null && resource.data.fy == request.resource.data.fy && request.resource.data.next == resource.data.next + 1)));
    }
    // Money paid out by the gurdwara (Pathi Singh bheta and other expenses): Khazanchi and Pardhan.
    match /expenses/{id} {
      allow read, write: if isTreasurer();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Users ----------
    // Invites: the Pardhan adds an email and role. That person makes a password, confirms the email,
    // and then their own "staff" record is created with exactly the invited role.
    function invitePath(email) { return /databases/$(database)/documents/invites/$(email); }
    match /invites/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'createdAt', 'by'])
        && request.resource.data.role in ['admin', 'treasurer', 'sevadar']
        && text(request.resource.data.name, 80);
      allow delete: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == email && exists(staffPath()));
    }
    match /staff/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(invitePath(request.auth.token.email.lower()))
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'createdAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == get(invitePath(request.auth.token.email.lower())).data.role
        && request.resource.data.name == get(invitePath(request.auth.token.email.lower())).data.name
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      // The Pardhan can change a role or switch a user off, but not their own.
      allow update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'active'])
        && request.resource.data.role in ['admin', 'treasurer', 'sevadar'] && request.resource.data.active is bool;
      allow delete: if false;
    }
    // Activity log: every committee action, who did it and when. Nobody can change or delete it.
    match /log/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['at', 'by', 'email', 'name', 'role', 'action', 'ref', 'detail'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && text(request.resource.data.action, 80)
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow update, delete: if false;
    }

    // ---------- Pathi Singhs ----------
    // Their PIN is stored only as a hash and is never readable from the website;
    // the Pathi Singh's own page is served by the server (netlify/functions/pathi.mjs).
    match /pathis/{id} {
      allow read: if isStaff();
      allow create, update: if isTreasurer();
      allow delete: if isAdmin();
    }
    match /pathipins/{id} {
      allow read: if false;
      allow create, update: if isTreasurer()
        && request.resource.data.keys().hasOnly(['hash', 'fails', 'lockUntil'])
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64;
      allow delete: if isAdmin();
    }
    match /rosters/{ref} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.ref == ref && request.resource.data.rauls.size() <= 60;
      allow delete: if isAdmin();
    }

    // ---------- Seva sign-up for programmes (gurpurabs) ----------
    match /signups/{id} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['prog', 'date', 'title', 'seva', 'name', 'phone', 'note', 'createdAt'])
        && text(request.resource.data.prog, 20) && isDate(request.resource.data.date)
        && text(request.resource.data.title, 120) && text(request.resource.data.seva, 80)
        && text(request.resource.data.name, 80)
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9+ -]{7,20}$')
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isStaff();
    }

    // First committee members: one document per member, named with their User UID (added by hand in Firebase).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // add committee members by hand in the Firebase console
    }
    match /Gurlal/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /sevaonly/{ref} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff() || (ref.matches('^S[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(['name', 'amount', 'purpose', 'utr', 'status', 'createdAt'])
        && request.resource.data.status == 'checking'
        && request.resource.data.amount is int && request.resource.data.amount >= 1 && request.resource.data.amount <= 100000
        && text(request.resource.data.name, 150)
        && request.resource.data.purpose is string && request.resource.data.purpose.size() <= 80
        && request.resource.data.utr is string && request.resource.data.utr.matches('^[0-9A-Za-z]{6,30}$')
        && request.resource.data.createdAt == request.time
        && existsAfter(sevaContactPath(ref)));
      // A sevadar can confirm or mark not received; making a seva receipt void is for the Khazanchi / Pardhan.
      allow update: if isTreasurer()
        || (isStaff() && !('void' in request.resource.data.get('receipt', {})));
      allow delete: if isAdmin();
    }
    match /sevacontacts/{ref} {
      allow read: if isStaff();
      allow create: if isStaff() || (!exists(sevaContactPath(ref))
        && existsAfter(sevaPath(ref))
        && request.resource.data.keys().hasOnly(['phone', 'pkey', 'createdAt'])
        && text(request.resource.data.phone, 20)
        && request.resource.data.pkey is string && request.resource.data.pkey.size() <= 20
        && request.resource.data.createdAt == request.time);
      allow update, delete: if isAdmin();
    }
  }
}
